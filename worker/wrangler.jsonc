{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alixsbrain-capture",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "alixsbrain",
    "database_id": "86f925d3-ecd9-4856-ab07-4269d8b85f87", "migrations_dir": "migrations"
  }]
}
